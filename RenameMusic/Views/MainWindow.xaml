<Window x:Class="RenameMusic.Views.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:lang="clr-namespace:RenameMusic.Resources.Languages"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding MainWindowTitle}"
        MinWidth="650"
        MinHeight="400"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Window.Background}"
        Foreground="{DynamicResource Window.Foreground}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition MinWidth="400" />
        </Grid.ColumnDefinitions>

        <Menu Grid.ColumnSpan="2">
            <MenuItem Header="{x:Static lang:Strings.FILE}">
                <MenuItem Header="{x:Static lang:Strings.ADD_FILE}"
                          Command="{Binding AddFilesCommand}" />
                <MenuItem Header="{x:Static lang:Strings.ADD_FOLDER}"
                          Command="{Binding AddFoldersCommand}" />
                <MenuItem Header="{x:Static lang:Strings.LOAD_PREV_DATA}"
                          Command="{Binding LoadPreviousDataCommand}" />
                <Separator />
                <MenuItem Header="{x:Static lang:Strings.RENAME_FILES}"
                          Command="{Binding RenameFilesCommand}"
                          IsEnabled="{Binding CanRename}" />
                <Separator />
                <MenuItem Header="{x:Static lang:Strings.EXIT}"
                          Command="{Binding ExitAppCommand}" />
            </MenuItem>

            <MenuItem Header="{x:Static lang:Strings.SETTINGS}">
                <MenuItem Header="{x:Static lang:Strings.REPLACE_WITH}"
                          Command="{Binding OpenTemplateDialogCommand}" />
                <MenuItem Header="{x:Static lang:Strings.SEARCH_SUBFOLDERS}"
                          IsCheckable="True"
                          IsChecked="{Binding IncludeSubFolders, Mode=TwoWay}" />
                <Separator />
                <MenuItem Header="{Binding MissingTagsModeText}">
                    <MenuItem Header="{Binding MissingTagsStrictText}"
                              IsCheckable="True"
                              IsChecked="{Binding UseStrictModeForMissingTags, Mode=OneWay}"
                              Command="{Binding SetMissingTagStrategyCommand}"
                              CommandParameter="False" />
                    <MenuItem Header="{Binding MissingTagsUseUnknownText}"
                              IsCheckable="True"
                              IsChecked="{Binding UsePlaceholderForMissingTags, Mode=OneWay}"
                              Command="{Binding SetMissingTagStrategyCommand}"
                              CommandParameter="True" />
                </MenuItem>
                <MenuItem Header="{Binding ConflictPolicyText}">
                    <MenuItem Header="{Binding ConflictAskEveryTimeText}"
                              IsCheckable="True"
                              IsChecked="{Binding IsConflictPolicyAsk, Mode=OneWay}"
                              Command="{Binding SetConflictPolicyCommand}"
                              CommandParameter="Ask" />
                    <MenuItem Header="{Binding ConflictAlwaysReplaceText}"
                              IsCheckable="True"
                              IsChecked="{Binding IsConflictPolicyReplace, Mode=OneWay}"
                              Command="{Binding SetConflictPolicyCommand}"
                              CommandParameter="Replace" />
                    <MenuItem Header="{Binding ConflictAlwaysSkipText}"
                              IsCheckable="True"
                              IsChecked="{Binding IsConflictPolicySkip, Mode=OneWay}"
                              Command="{Binding SetConflictPolicyCommand}"
                              CommandParameter="Skip" />
                    <MenuItem Header="{Binding ConflictAlwaysRenameWithNumberText}"
                              IsCheckable="True"
                              IsChecked="{Binding IsConflictPolicyRenameWithNumber, Mode=OneWay}"
                              Command="{Binding SetConflictPolicyCommand}"
                              CommandParameter="RenameWithNumber" />
                </MenuItem>
                <MenuItem Header="{x:Static lang:Strings.THEME}">
                    <MenuItem Header="{Binding ThemeDarkText}"
                              IsCheckable="True"
                              IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                              Command="{Binding SelectThemeCommand}"
                              CommandParameter="Dark" />
                    <MenuItem Header="{Binding ThemeLightText}"
                              IsCheckable="True"
                              IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                              Command="{Binding SelectThemeCommand}"
                              CommandParameter="Light" />
                </MenuItem>
                <MenuItem Header="{x:Static lang:Strings.LANGUAGE}">
                    <MenuItem Header="{Binding LanguageEnglishText}"
                              IsCheckable="True"
                              IsChecked="{Binding IsEnglishLanguage, Mode=OneWay}"
                              Command="{Binding SelectLanguageCommand}"
                              CommandParameter="en" />
                    <MenuItem Header="{Binding LanguageSpanishText}"
                              IsCheckable="True"
                              IsChecked="{Binding IsSpanishLanguage, Mode=OneWay}"
                              Command="{Binding SelectLanguageCommand}"
                              CommandParameter="es" />
                </MenuItem>
                <Separator />
                <MenuItem Header="{x:Static lang:Strings.RESTORE_SETTINGS}"
                          Command="{Binding RestoreSettingsCommand}" />
            </MenuItem>
        </Menu>

        <Button
                Grid.Row="1"
                Margin="10"
                Height="30"
                VerticalAlignment="Top"
                HorizontalAlignment="Stretch"
                Content="{x:Static lang:Strings.RENAME_FILES}"
                Command="{Binding RenameFilesCommand}"
                IsEnabled="{Binding CanRename}" />

        <Image Grid.Row="1"
               Width="230"
               Height="230"
               Margin="0,80,0,0"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Panel.ZIndex="1"
               Source="{Binding SelectedCover}"
               d:Source="./../Resources/Icons/icon.ico" />
        <Rectangle Grid.Row="1"
                   Width="230"
                   Height="230"
                   Margin="0,80,0,0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Stroke="{DynamicResource Window.Background}"
                   StrokeThickness="5" />

        <TabControl Grid.Row="1"
                    Grid.Column="1"
                    Margin="10"
                    HorizontalAlignment="Stretch"
                    Visibility="{Binding HasSessionData, Converter={StaticResource BoolToVisibilityConverter}}">
            <TabItem Header="{x:Static lang:Strings.TO_RENAME}">
                <DataGrid ItemsSource="{Binding ToRenameItems}"
                          SelectedItem="{Binding SelectedToRenameItem, Mode=TwoWay}"
                          Margin="10"
                          AutoGenerateColumns="False"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static lang:Strings.NAME}"
                                            Binding="{Binding Name}" IsReadOnly="True" />
                        <DataGridTextColumn Header="{x:Static lang:Strings.NEW_NAME}"
                                            Binding="{Binding NewName}" IsReadOnly="True" />
                        <DataGridTextColumn Header="{x:Static lang:Strings.TYPE}"
                                            Width="36"
                                            Binding="{Binding Type}" IsReadOnly="True" />
                        <DataGridTextColumn Header="{x:Static lang:Strings.DURATION}"
                                            Width="52"
                                            Binding="{Binding Duration, StringFormat=hh\\:mm\\:ss}" IsReadOnly="True" />
                        <DataGridTextColumn Header="{x:Static lang:Strings.TITLE}"
                                            Binding="{Binding Title}" IsReadOnly="True" />
                        <DataGridTextColumn Header="{x:Static lang:Strings.TRACK_NUM}"
                                            Binding="{Binding TrackNum}" IsReadOnly="True" />
                        <DataGridTextColumn Header="{x:Static lang:Strings.ALBUM}"
                                            Binding="{Binding Album}" IsReadOnly="True" />
                        <DataGridTextColumn Header="{x:Static lang:Strings.ARTIST}"
                                            Binding="{Binding Artist}" IsReadOnly="True" />
                        <DataGridTextColumn Header="{x:Static lang:Strings.ALBUM_ARTIST}"
                                            Binding="{Binding AlbumArtist}" IsReadOnly="True" />
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static lang:Strings.PLAY_FILE}"
                                      Command="{Binding DataContext.PlayAudioCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{x:Static lang:Strings.EDIT_TAGS}"
                                      Command="{Binding DataContext.EditAudioTagsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="{x:Static lang:Strings.DO_NOT_RENAME}"
                                      Command="{Binding DataContext.MoveToDoNotRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{x:Static lang:Strings.RENAME_THIS_NOW}"
                                      Command="{Binding DataContext.RenameThisNowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="{x:Static lang:Strings.DELETE_FILE}"
                                      Command="{Binding DataContext.DeleteAudioFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="{x:Static lang:Strings.OPEN_IN_EXPLORER}"
                                      Command="{Binding DataContext.OpenAudioInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </TabItem>

            <TabItem Header="{x:Static lang:Strings.DO_NOT_RENAME}">
                <DataGrid ItemsSource="{Binding DoNotRenameItems}"
                          SelectedItem="{Binding SelectedDoNotRenameItem, Mode=TwoWay}"
                          Margin="10"
                          AutoGenerateColumns="False"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static lang:Strings.NAME}"
                                            Binding="{Binding Name}" IsReadOnly="True" />
                        <DataGridTextColumn Header="{x:Static lang:Strings.TYPE}"
                                            Width="36"
                                            Binding="{Binding Type}" IsReadOnly="True" />
                        <DataGridTextColumn Header="{x:Static lang:Strings.DURATION}"
                                            Width="52"
                                            Binding="{Binding Duration, StringFormat=hh\\:mm\\:ss}" IsReadOnly="True" />
                        <DataGridTemplateColumn IsReadOnly="True">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{Binding DataContext.ReasonColumnHeaderText, ElementName=RootWindow}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Reason}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static lang:Strings.PLAY_FILE}"
                                      Command="{Binding DataContext.PlayAudioCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{x:Static lang:Strings.EDIT_TAGS}"
                                      Command="{Binding DataContext.EditAudioTagsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="{x:Static lang:Strings.TO_RENAME}"
                                      Command="{Binding DataContext.TryMoveToRenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="{x:Static lang:Strings.DELETE_FILE}"
                                      Command="{Binding DataContext.DeleteAudioFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="{x:Static lang:Strings.OPEN_IN_EXPLORER}"
                                      Command="{Binding DataContext.OpenAudioInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </TabItem>

            <TabItem Header="{x:Static lang:Strings.FOLDERS}">
                <DataGrid ItemsSource="{Binding FolderItems}"
                          SelectedItem="{Binding SelectedFolderItem, Mode=TwoWay}"
                          Margin="10"
                          AutoGenerateColumns="False"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="36" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Width="24"
                                            Height="24"
                                            Content="X"
                                            Command="{Binding DataContext.RemoveFolderFromSessionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{x:Static lang:Strings.DIRECTORY}"
                                            Binding="{Binding Path}" IsReadOnly="True" />
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static lang:Strings.REMOVE_FROM_LIST}"
                                      Command="{Binding DataContext.RemoveFolderFromSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="{x:Static lang:Strings.DELETE_FOLDER}"
                                      Command="{Binding DataContext.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="{x:Static lang:Strings.OPEN_IN_EXPLORER}"
                                      Command="{Binding DataContext.OpenFolderInExplorerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Grid.ColumnSpan="2">
            <StatusBarItem>
                <TextBlock Margin="2,0" Text="{Binding LoadedStatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Margin="2,0" Text="{Binding MainStatusText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
