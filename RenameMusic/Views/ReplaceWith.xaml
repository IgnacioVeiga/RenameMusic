<Window x:Class="RenameMusic.Views.ReplaceWith"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p="clr-namespace:RenameMusic.Resources.Languages"
        Width="560"
        Height="430"
        ResizeMode="NoResize"
        Title="{x:Static p:Strings.REPLACE_WITH}"
        Background="{DynamicResource Window.Background}"
        Foreground="{DynamicResource Window.Foreground}"
        mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Margin="10,8,10,4"
                   Text="{x:Static p:Strings.RW_DESCRIPTION}"
                   TextWrapping="WrapWithOverflow" />

        <Grid Grid.Row="1"
              Margin="10,6,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center"
                       Text="{x:Static p:Strings.MIN_TAG_REQ}" />
            <ComboBox Grid.Column="1"
                      Margin="10,0,0,0"
                      SelectedIndex="{Binding MinTagsRequiredIndex, Mode=TwoWay}">
                <ComboBoxItem Content="{x:Static p:Strings.NONE_REQ}" />
                <ComboBoxItem Content="{x:Static p:Strings.ONLY_MARKED_ONES}" />
                <ComboBoxItem Content="{x:Static p:Strings.ALL_MENTIONED}" />
            </ComboBox>
        </Grid>

        <TextBlock Grid.Row="2"
                   Margin="10,6,10,4"
                   Text="{x:Static p:Strings.ADD_TAG}" />

        <WrapPanel Grid.Row="3"
                   Margin="10,4,10,4">
            <Button Margin="0,0,6,6"
                    Padding="10,4"
                    Content="Track Nº"
                    Command="{Binding InsertTagCommand}"
                    CommandParameter="&lt;TrackNum&gt;" />
            <Button Margin="0,0,6,6"
                    Padding="10,4"
                    Content="Title"
                    Command="{Binding InsertTagCommand}"
                    CommandParameter="&lt;Title&gt;" />
            <Button Margin="0,0,6,6"
                    Padding="10,4"
                    Content="Album"
                    Command="{Binding InsertTagCommand}"
                    CommandParameter="&lt;Album&gt;" />
            <Button Margin="0,0,6,6"
                    Padding="10,4"
                    Content="Album Artist"
                    Command="{Binding InsertTagCommand}"
                    CommandParameter="&lt;AlbumArtist&gt;" />
            <Button Margin="0,0,6,6"
                    Padding="10,4"
                    Content="Artist"
                    Command="{Binding InsertTagCommand}"
                    CommandParameter="&lt;Artist&gt;" />
            <Button Margin="0,0,6,6"
                    Padding="10,4"
                    Content="Year"
                    Command="{Binding InsertTagCommand}"
                    CommandParameter="&lt;Year&gt;" />
        </WrapPanel>

        <TextBox Grid.Row="4"
                 Margin="10,4,10,4"
                 Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Grid.Row="5"
                    Margin="10,6,10,4">
            <TextBlock Text="{x:Static p:Strings.ONLY_MARKED_ONES}" />
            <WrapPanel Margin="0,6,0,0">
                <CheckBox Margin="0,0,10,4"
                          Content="Track Nº"
                          IsChecked="{Binding TrackNumRequired, Mode=TwoWay}" />
                <CheckBox Margin="0,0,10,4"
                          Content="Title"
                          IsChecked="{Binding TitleRequired, Mode=TwoWay}" />
                <CheckBox Margin="0,0,10,4"
                          Content="Album"
                          IsChecked="{Binding AlbumRequired, Mode=TwoWay}" />
                <CheckBox Margin="0,0,10,4"
                          Content="Album Artist"
                          IsChecked="{Binding AlbumArtistRequired, Mode=TwoWay}" />
                <CheckBox Margin="0,0,10,4"
                          Content="Artist"
                          IsChecked="{Binding ArtistRequired, Mode=TwoWay}" />
                <CheckBox Margin="0,0,10,4"
                          Content="Year"
                          IsChecked="{Binding YearRequired, Mode=TwoWay}" />
            </WrapPanel>

        </StackPanel>

        <TextBlock Grid.Row="6"
                   Margin="10,8,10,0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Foreground="Red"
                   FontWeight="SemiBold"
                   Text="{Binding WarningMessage}" />

        <Grid Grid.Row="7"
              Margin="10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Width="100"
                    Margin="0,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Command="{Binding ApplyCommand}"
                    IsEnabled="{Binding CanApply}"
                    IsCancel="False"
                    IsDefault="True"
                    Content="{x:Static p:Strings.APPLY}" />

            <Button Grid.Column="1"
                    Width="100"
                    Margin="0,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"
                    Content="{x:Static p:Strings.CANCEL}" />
        </Grid>
    </Grid>
</Window>
